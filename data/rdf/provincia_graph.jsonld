      }
    ],
    "https://provincia.uni-graz.at/ontology/certainty": [
      {
        "@value": "high"
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "vor dem Konsulat; auf dem Gerasa-Titel consul designatus"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-544"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Legatus Augusti pr. pr. (Arabiae)"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Attested in inscriptions from Gerasa."
      },
      {
        "@value": "In der PIR 'consul (suffectus anno incerto saec. II medii)' — die Klammer markiert Erschlossenes (belegt nur 'consul'); diese Datierung gilt dem KONSULAT, nicht der Statthalterschaft. Arabia-Statthalterschaft (CIL III 118 = 14156^3, Gerasa) faellt kurz vor das Konsulat (dort consul designatus). Moegliche Identitaet mit C. Allius C. f. Fuscianus (Ostia a. 140, a. 152)."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/arabia"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Arabia"
      }
    ]
  },
