      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Legatus Augusti pro praetore provinciae Arabiae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "The governorship of Arabia is securely attested by the Gerasene inscription IGR III 1371."
      },
      {
        "@value": "The conjectural identification in Wadd. 2460 and its date of 209 do not date this secure Arabia factoid."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/arabia"
      }
