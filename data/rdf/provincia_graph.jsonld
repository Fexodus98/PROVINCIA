    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Commemorated in a mutilated inscription dedicated to Marcus Aurelius and Lucius Verus by the Comanenses."
      },
      {
        "@value": "Amt 'fortasse' (verstuemmelte Inschrift IGR 3, 106 aus Comana); aus gemeinsamer Regierung Marcus + Verus erschlossen (161-169)."
      }
    ],
