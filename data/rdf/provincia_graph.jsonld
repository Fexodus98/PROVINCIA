    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "a. 173 aerae Bostrenae i.e. a. 278/279 p. C."
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-1570"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "uncertain_reading"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Incertum utrum legatus Aug. pr. pr. fuerit an praeses dignitatis equestris."
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "The title legatus Aug. pr. pr. is proposed as an alternative possibility to equestrian praeses, but is marked as uncertain."
      },
      {
        "@value": "Arabia seit 106 n. Chr. kaiserliche Provinz. Fuer Aur. Petrus (278/279, hegemon/praeses Arabiae) bleibt unsicher, ob legatus Augusti pro praetore oder ritterlicher praeses; die Inschrift nennt ihn diasemotatos (= perfectissimus, ritterlich). Unter Vorbehalt aufgenommen — koennte leg. Aug. pr. pr. gewesen sein."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
