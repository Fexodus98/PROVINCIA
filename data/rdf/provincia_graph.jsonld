      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-534"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "inferred_from_context"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "videtur fuisse legatus Pannoniae superioris"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Statthalterschaft von Pannonia superior nicht explizit bezeugt; erschlossen allein daraus, dass Alfius als Senator im zentralen Verwaltungssitz Pannoniens geehrt wurde — CIL III 14356^4 (= EDH HD072856). Moeglicherweise Statthalter von Pannonia superior; sehr geringe Sicherheit."
      },
      {
        "@value": "Personenidentitaet: moeglicherweise dieselbe Person wie A 535 (P. Alfius Maximus Numerius Licinianus). PIR wechselseitig: bei 534 'Fortasse non diversus ab eo qui sequitur', bei 535 'Potest idem esse is, qui praecedit'. sameAs-Kandidat."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/pannonia-superior"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Pannonia superior"
      }
    ]
  },
