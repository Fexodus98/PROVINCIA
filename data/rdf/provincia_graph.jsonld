  {
    "@id": "https://provincia.uni-graz.at/resource/factoid/pir-a-260-gov-2-thracia",
    "@type": [
      "https://provincia.uni-graz.at/ontology/GovernorshipFactoid"
    ],
    "https://provincia.uni-graz.at/ontology/aboutPerson": [
      {
        "@id": "https://provincia.uni-graz.at/resource/person/pir-a-260-p-aelius-severianus-maximus-a260"
      }
    ],
    "https://provincia.uni-graz.at/ontology/certainty": [
      {
        "@value": "low"
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "nach Arabia (nach 194); konsularisch"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-260"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "inferred_from_context"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Severianum post consulatum legatum provinciae Thraciae fuisse viri docti e titulo 2 filio Perinthi dicato collegerunt (cf. Stein Thracia p. 39 sq.), dubito num iure"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Von A. Stein erschlossen: Ehreninschrift Perinth (IGR I 794 = AEM VIII 217,43) fuer den Sohn A 261 nennt den Vater lamprotatos hypatikos (vir clarissimus consularis); da A 260 Statthalter von Arabia (193/194, praetorisch) und hier Konsular ist, verwaltete er Thracia (konsularisch) nach Arabia. Erschlossen, nicht direkt bezeugt."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/thracia"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Thracia"
      }
    ]
  },
