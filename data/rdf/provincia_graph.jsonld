        "@value": 209
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "a. 209 (conjectural attribution of Wadd. 2460)"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-519"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "uncertain_reading"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "hunc nominatum fuisse in t. posito a. 209, Wadd. 2460, ubi nomina legati perierunt praeter ....ητιανοῦ, suspicati sunt Bruennow et Domaszewski; qui simul monuerunt fieri posse ut non Arabiae sed Syriae legatus in hoc t. memoratus sit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Both the identification of the fragmentary name ...ητιανοῦ with A 519 and the assignment of the inscription to Syria are conjectural."
      },
      {
        "@value": "The PIR author explicitly adds 'dubito num recte'."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/syria"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Syria"
      }
    ]
  },
