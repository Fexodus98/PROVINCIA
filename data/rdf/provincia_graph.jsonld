        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 165
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "a. 165/166 (Thomasson); consul designatus a. 166"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-1070"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "legatus Aug. pr. pr. (exercitus Africani), consul designatus a. 166"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "De facto — wenn nicht de iure (Numidia wurde erst in severischer Zeit eigene kaiserliche Provinz) — Statthalter von Numidia als Befehlshaber der legio III Augusta (exercitus Africani). Moeglicherweise identisch mit der in CIL VIII 4195 (Verecunda) genannten Person (PIR: \"Nescio an idem sit\"). Bengt E. Thomasson, \"Die Statthalter der roemischen Provinzen Nordafrikas von Augustus bis Diokletian\" (S. 181), fuehrt einen Venustus als Statthalter Numidiens fuer 165/166. Personenidentitaet nicht voellig gesichert -> certainty=medium."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/numidia"
      }
    ]
  },
