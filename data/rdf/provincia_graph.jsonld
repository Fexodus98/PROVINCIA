  {
    "@id": "https://provincia.uni-graz.at/resource/factoid/pir-a-1408-gov-1",
    "@type": [
      "https://provincia.uni-graz.at/ontology/GovernorshipFactoid"
    ],
    "https://provincia.uni-graz.at/ontology/aboutPerson": [
      {
        "@id": "https://provincia.uni-graz.at/resource/person/pir-a-1408-person-1408"
      }
    ],
    "https://provincia.uni-graz.at/ontology/certainty": [
      {
        "@value": "medium"
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateNormalizedEnd": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 118
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateNormalizedStart": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 116
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "bis 117/118 ('ab Hadriano e provincia avocatum', dann hingerichtet); Beginn ungewiss (~116)"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-1408"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Legatus Aug. pr. pr. t. 8 Moesiae superioris potius quam Daciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Premerstein argued he was recalled from the province in 117/118 by Hadrian."
      },
      {
        "@value": "Domaszewski (CIL III 7904): Statthalter jener Provinz, zu deren Heer die legio IV Flavia Felix gehoerte = Moesia superior. Dedikant M. Calventius Viator war Centurio der legio IV Flavia Felix; Fundort Sarmizegetusa/Dacia allein nicht entscheidend (equites singulares konnten einen Ausbilder aus dem Heer einer Nachbarprovinz haben). Daher wahrscheinlicher Moesia superior; Dacia nicht sicher auszuschliessen ('potius quam Daciae'). Viator spaeter unter den equites singulares Hadriani in Gerasa (129/130 oder 131/132)."
      },
      {
        "@value": "Dublette-Faktoid 'Dacia' (gleicher Beleg CIL III 7904) entfernt."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/moesia-superior"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Moesia superior"
      }
    ]
  },
