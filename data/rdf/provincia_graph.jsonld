        "@value": 166
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "ante a. 169 t. 5 ... a. 169/70 t. 2. 4. 7, a. 170/1 vel postea t. 3, 171/2 t. 1"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-1402"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Legatus Augusti pro praetore (provinciae Syriae) t. 1—5. 7—10 (ὑπατικός t. 1.4.7.9 ; ὁ λαμπρότατος t. 1. 4. 7 ; consularis t. 10). Vita 5. 6, ante a. 169 t. 5 (sed nondum a. 163, quo Cn. Iulius Verus Syriam rexit, qui usque ad annum 165 in hac provincia mansisse potest CIL III 199 = D. 5864), a. 169/70 t. 2. 4. 7, a. 170/1 vel postea t. 3, 171/2 t. 1."
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Attested in multiple inscriptions (t. 1-5, 7-10) and literary sources."
      },
      {
        "@value": "Nondum a. 163, quo Cn. Iulius Verus Syriam rexit."
      },
      {
        "@value": "Vorgaenger Cn. Iulius Verus bis ~165; Statthalterschaft belegt bis 171/2; danach ausserordentliches Ostkommando bis zum Aufstand 175; kein Arabia-Kommando (Ritterling irrt: 'Haud recte … Arabiae praefuisse')."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/syria"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Syria"
      }
    ]
  },
