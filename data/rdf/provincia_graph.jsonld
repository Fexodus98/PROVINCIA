  {
    "@id": "https://provincia.uni-graz.at/resource/factoid/pir-a-1130-gov-arruntius-hispania",
    "@type": [
      "https://provincia.uni-graz.at/ontology/GovernorshipFactoid"
    ],
    "https://provincia.uni-graz.at/ontology/aboutPerson": [
      {
        "@id": "https://provincia.uni-graz.at/resource/person/pir-a-1130-person-l-arruntius"
      }
    ],
    "https://provincia.uni-graz.at/ontology/certainty": [
      {
        "@value": "high"
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateNormalizedStart": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 21
      }
    ],
    "https://provincia.uni-graz.at/ontology/dateText": [
      {
        "@value": "A. 21 - 37"
      }
    ],
    "https://provincia.uni-graz.at/ontology/derivedFromEntry": [
      {
        "@id": "https://provincia.uni-graz.at/resource/entry/pir-a-1130"
      }
    ],
    "https://provincia.uni-graz.at/ontology/evidenceType": [
      {
        "@value": "explicit"
      }
    ],
    "https://provincia.uni-graz.at/ontology/exactText": [
      {
        "@value": "Hispaniam (citeriorem) regendam accepit (legatus Augusti pro praetore), sed provinciam absens gubernare coactus est, a Tiberio ob metum Romae retentus"
      }
    ],
    "https://provincia.uni-graz.at/ontology/normalizedOffice": [
      {
        "@id": "https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"
      }
    ],
    "https://provincia.uni-graz.at/ontology/note": [
      {
        "@value": "Arruntius was appointed to govern Hispania Citerior but was forced to govern in absence because Tiberius detained him in Rome out of fear."
      },
      {
        "@value": "Tacitus (Ann. 6, 27) states in 33 AD that Arruntius had been detained for ten years, though L. Piso was in charge of Hispania Citerior in 25 AD. It is probable that Arruntius succeeded Piso after the latter's death in 25 AD."
      },
      {
        "@value": "Enddatum ungewiss: 'incertum, num Hispaniae legationem usque ad finem vitae retinuerit'."
      }
    ],
    "https://provincia.uni-graz.at/ontology/province": [
      {
        "@id": "https://provincia.uni-graz.at/resource/province/hispania-citerior"
      }
    ],
    "https://provincia.uni-graz.at/ontology/provinceText": [
      {
        "@value": "Hispaniam (citeriorem)"
      }
    ]
  },
