      <ont:Province rdf:about="https://provincia.uni-graz.at/resource/province/germania-superior">
        <rdfs:label>Germania superior</rdfs:label>
        <ont:attestedForm>Germania superior</ont:attestedForm>
        <ont:attestedForm>Germaniae superioris</ont:attestedForm>
      </ont:Province>
    </ont:province>
    <ont:note>Governed Germania Superior as legatus Aug. pro pr.</ont:note>
    <ont:note>The governorship is secure, but the beginning in AD 55 is only probable ('probabiliter iam a. 55'); the legateship in AD 56 is explicit.</ont:note>
  </ont:GovernorshipFactoid>
