    <ont:provinceText>Arabia</ont:provinceText>
    <ont:province rdf:resource="https://provincia.uni-graz.at/resource/province/arabia"/>
    <ont:note>In Stufe 5 faelschlich verworfen ('Legatus Aug. pro pr. (Arabiae)' — abgekuerzt/Klammer); manuell wieder aufgenommen.</ont:note>
