  <ont:GovernorshipFactoid rdf:about="https://provincia.uni-graz.at/resource/factoid/pir-a-1570-gov-1570-1">
    <ont:aboutPerson>
      <ont:Person rdf:about="https://provincia.uni-graz.at/resource/person/pir-a-1570-person-1570">
        <ont:displayedName>Aur(elius) Petrus</ont:displayedName>
        <ont:normalizedName>Aurelius Petrus</ont:normalizedName>
        <ont:pirReference>A 1570</ont:pirReference>
        <ont:attestedIn rdf:resource="https://provincia.uni-graz.at/resource/entry/pir-a-1570"/>
        <ont:statusMarker>praeses</ont:statusMarker>
        <ont:statusMarker>vir perfectissimus</ont:statusMarker>
        <ont:note>Governed the province of Arabia in 278/279 AD.</ont:note>
        <ont:note>'vir perfectissimus' (diasemotatos) belegt -&gt; Hinweis auf moeglichen Ritterrang, nicht gesicherter senatorischer Status.</ont:note>
      </ont:Person>
    </ont:aboutPerson>
    <ont:derivedFromEntry>
      <ont:PIREntry rdf:about="https://provincia.uni-graz.at/resource/entry/pir-a-1570">
        <rdfs:label>Aur(elius) Petrus</rdfs:label>
        <ont:pirReference>A 1570</ont:pirReference>
        <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">337</ont:sourcePage>
        <ont:sourceWork rdf:resource="https://provincia.uni-graz.at/resource/source/pir-work"/>
        <ont:needsReview rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ont:needsReview>
        <ont:reviewVerdict>human_corrected</ont:reviewVerdict>
      </ont:PIREntry>
    </ont:derivedFromEntry>
    <ont:exactText>Incertum utrum legatus Aug. pr. pr. fuerit an praeses dignitatis equestris.</ont:exactText>
    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">337</ont:sourcePage>
    <ont:dateText>a. 173 aerae Bostrenae i.e. a. 278/279 p. C.</ont:dateText>
    <ont:certainty>low</ont:certainty>
    <ont:evidenceType>uncertain_reading</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">278</ont:dateNormalizedStart>
    <ont:dateNormalizedEnd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">279</ont:dateNormalizedEnd>
    <ont:normalizedOffice>
      <ont:Office rdf:about="https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae">
        <rdfs:label>legatus Augusti pro praetore provinciae</rdfs:label>
      </ont:Office>
    </ont:normalizedOffice>
    <ont:provinceText>Arabia</ont:provinceText>
    <ont:province>
      <ont:Province rdf:about="https://provincia.uni-graz.at/resource/province/arabia">
        <rdfs:label>Arabia</rdfs:label>
        <ont:attestedForm>Arabia</ont:attestedForm>
      </ont:Province>
    </ont:province>
    <ont:note>The title legatus Aug. pr. pr. is proposed as an alternative possibility to equestrian praeses, but is marked as uncertain.</ont:note>
    <ont:note>Arabia seit 106 n. Chr. kaiserliche Provinz. Fuer Aur. Petrus (278/279, hegemon/praeses Arabiae) bleibt unsicher, ob legatus Augusti pro praetore oder ritterlicher praeses; die Inschrift nennt ihn diasemotatos (= perfectissimus, ritterlich). Unter Vorbehalt aufgenommen — koennte leg. Aug. pr. pr. gewesen sein.</ont:note>
  </ont:GovernorshipFactoid>
