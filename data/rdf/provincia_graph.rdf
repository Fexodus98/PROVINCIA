    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">152</ont:sourcePage>
    <ont:dateText>non ante Commodum (nach 180); Kaisername im Titel unvollstaendig, fruehestens Commodus; Ritterling erwog Elagabal</ont:dateText>
    <ont:certainty>high</ont:certainty>
    <ont:evidenceType>explicit</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">180</ont:dateNormalizedStart>
