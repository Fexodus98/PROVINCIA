    <ont:exactText>Legatus Aug. pro pr. Germaniae inferioris paullo post, fortasse ab a. 101 usque ad a. 103/104</ont:exactText>
    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</ont:sourcePage>
    <ont:dateText>paullo post [a. 100], fortasse ab a. 101 usque ad a. 103/104</ont:dateText>
    <ont:certainty>high</ont:certainty>
    <ont:evidenceType>explicit</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">101</ont:dateNormalizedStart>
    <ont:dateNormalizedEnd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">104</ont:dateNormalizedEnd>
