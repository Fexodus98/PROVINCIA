  <ont:GovernorshipFactoid rdf:about="https://provincia.uni-graz.at/resource/factoid/pir-a-659-gov-a659-1">
    <ont:aboutPerson>
      <ont:Person rdf:about="https://provincia.uni-graz.at/resource/person/pir-a-659-person-a659">
        <ont:displayedName>L. Annius Italicus</ont:displayedName>
        <ont:normalizedName>Lucius Annius Italicus</ont:normalizedName>
        <ont:pirReference>A 659</ont:pirReference>
        <ont:attestedIn rdf:resource="https://provincia.uni-graz.at/resource/entry/pir-a-659"/>
        <ont:statusMarker>senator</ont:statusMarker>
        <ont:statusMarker>consularis</ont:statusMarker>
        <ont:note>Governor of Moesia Inferior in AD 224.</ont:note>
        <ont:note>Beziehung zu A 660 (L. Annius Italicus Rutilianus): Verwandtschaft gesichert, Grad unsicher — Sohn ODER Enkel. PIR: A 660 'Italici filius … cf. n. 659'; offen, ob der Vater A 659 selbst ('hic') oder dessen gleichnamiger Sohn Italicus ist ('Incertum utrum hic an filius Italicus, qui L. Annio Italico Rutiliano filio posuit t. sepulcralem XI 5808 Iguvinum'). Sohn (falls A 659 = Italicus) oder Enkel (falls ueber den Sohn Italicus). Enkel-Deutung: Danuta Okon, Res Historica 59 (2025). Beleg CIL XI 5808.</ont:note>
      </ont:Person>
    </ont:aboutPerson>
    <ont:derivedFromEntry>
