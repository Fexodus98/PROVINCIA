    <ont:exactText>Legatus Aug. pro pr. (Galatiae) t. 1—4 a. 198 t. 2. 3 (ubi Septimius Severus appellatur tribuniciae potestatis VI imp. XI), a. 200 t. 4 (trib. pot. VIII; vix fuit VIIIT)</ont:exactText>
    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">285</ont:sourcePage>
    <ont:dateText>a. 198 - a. 200</ont:dateText>
    <ont:certainty>high</ont:certainty>
    <ont:evidenceType>explicit</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">198</ont:dateNormalizedStart>
    <ont:dateNormalizedEnd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</ont:dateNormalizedEnd>
    <ont:normalizedOffice rdf:resource="https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"/>
    <ont:provinceText>Galatiae</ont:provinceText>
    <ont:province rdf:resource="https://provincia.uni-graz.at/resource/province/galatia"/>
    <ont:note>The milestones date to the reign of Septimius Severus, specifically mentioning his tribunician power VI (198 AD) and VIII (200 AD).</ont:note>
  </ont:GovernorshipFactoid>
