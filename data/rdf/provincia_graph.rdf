        <ont:sourceWork rdf:resource="https://provincia.uni-graz.at/resource/source/pir-work"/>
        <ont:needsReview rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ont:needsReview>
        <ont:reviewVerdict>human_corrected</ont:reviewVerdict>
      </ont:PIREntry>
    </ont:derivedFromEntry>
    <ont:exactText>Legatus Augusti pro praetore (provinciae Syriae) t. 1—5. 7—10 (ὑπατικός t. 1.4.7.9 ; ὁ λαμπρότατος t. 1. 4. 7 ; consularis t. 10). Vita 5. 6, ante a. 169 t. 5 (sed nondum a. 163, quo Cn. Iulius Verus Syriam rexit, qui usque ad annum 165 in hac provincia mansisse potest CIL III 199 = D. 5864), a. 169/70 t. 2. 4. 7, a. 170/1 vel postea t. 3, 171/2 t. 1.</ont:exactText>
    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">298</ont:sourcePage>
    <ont:dateText>ante a. 169 t. 5 ... a. 169/70 t. 2. 4. 7, a. 170/1 vel postea t. 3, 171/2 t. 1</ont:dateText>
    <ont:certainty>high</ont:certainty>
    <ont:evidenceType>explicit</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">166</ont:dateNormalizedStart>
    <ont:dateNormalizedEnd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">172</ont:dateNormalizedEnd>
    <ont:normalizedOffice rdf:resource="https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"/>
    <ont:provinceText>Syria</ont:provinceText>
    <ont:province rdf:resource="https://provincia.uni-graz.at/resource/province/syria"/>
    <ont:note>Attested in multiple inscriptions (t. 1-5, 7-10) and literary sources.</ont:note>
    <ont:note>Nondum a. 163, quo Cn. Iulius Verus Syriam rexit.</ont:note>
    <ont:note>Vorgaenger Cn. Iulius Verus bis ~165; Statthalterschaft belegt bis 171/2; danach ausserordentliches Ostkommando bis zum Aufstand 175; kein Arabia-Kommando (Ritterling irrt: 'Haud recte … Arabiae praefuisse').</ont:note>
  </ont:GovernorshipFactoid>
