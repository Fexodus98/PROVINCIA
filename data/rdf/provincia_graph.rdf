    <ont:exactText>legatus Aug. pr. pr. (exercitus Africani), consul designatus a. 166</ont:exactText>
    <ont:sourcePage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">225</ont:sourcePage>
    <ont:dateText>a. 165/166 (Thomasson); consul designatus a. 166</ont:dateText>
    <ont:certainty>medium</ont:certainty>
    <ont:evidenceType>explicit</ont:evidenceType>
    <ont:dateNormalizedStart rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">165</ont:dateNormalizedStart>
    <ont:dateNormalizedEnd rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">166</ont:dateNormalizedEnd>
    <ont:normalizedOffice rdf:resource="https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae"/>
    <ont:commandAreaText>exercitus Africanus</ont:commandAreaText>
    <ont:province rdf:resource="https://provincia.uni-graz.at/resource/province/numidia"/>
    <ont:note>De facto — wenn nicht de iure (Numidia wurde erst in severischer Zeit eigene kaiserliche Provinz) — Statthalter von Numidia als Befehlshaber der legio III Augusta (exercitus Africani). Moeglicherweise identisch mit der in CIL VIII 4195 (Verecunda) genannten Person (PIR: "Nescio an idem sit"). Bengt E. Thomasson, "Die Statthalter der roemischen Provinzen Nordafrikas von Augustus bis Diokletian" (S. 181), fuehrt einen Venustus als Statthalter Numidiens fuer 165/166. Personenidentitaet nicht voellig gesichert -&gt; certainty=medium.</ont:note>
  </ont:GovernorshipFactoid>
