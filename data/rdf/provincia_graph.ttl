<https://provincia.uni-graz.at/resource/factoid/pir-a-1570-gov-1570-1> a ont:GovernorshipFactoid ;
    ont:aboutPerson <https://provincia.uni-graz.at/resource/person/pir-a-1570-person-1570> ;
    ont:certainty "low" ;
    ont:dateNormalizedEnd 279 ;
    ont:dateNormalizedStart 278 ;
    ont:dateText "a. 173 aerae Bostrenae i.e. a. 278/279 p. C." ;
    ont:derivedFromEntry <https://provincia.uni-graz.at/resource/entry/pir-a-1570> ;
    ont:evidenceType "uncertain_reading" ;
    ont:exactText "Incertum utrum legatus Aug. pr. pr. fuerit an praeses dignitatis equestris." ;
    ont:normalizedOffice <https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae> ;
    ont:note "Arabia seit 106 n. Chr. kaiserliche Provinz. Fuer Aur. Petrus (278/279, hegemon/praeses Arabiae) bleibt unsicher, ob legatus Augusti pro praetore oder ritterlicher praeses; die Inschrift nennt ihn diasemotatos (= perfectissimus, ritterlich). Unter Vorbehalt aufgenommen — koennte leg. Aug. pr. pr. gewesen sein.",
        "The title legatus Aug. pr. pr. is proposed as an alternative possibility to equestrian praeses, but is marked as uncertain." ;
    ont:province <https://provincia.uni-graz.at/resource/province/arabia> .

