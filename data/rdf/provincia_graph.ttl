    ont:province <https://provincia.uni-graz.at/resource/province/galatia> .

<https://provincia.uni-graz.at/resource/factoid/pir-a-544-gov-a-544-1> a ont:GovernorshipFactoid ;
    ont:aboutPerson <https://provincia.uni-graz.at/resource/person/pir-a-544-person-a-544> ;
    ont:certainty "high" ;
    ont:dateText "vor dem Konsulat; auf dem Gerasa-Titel consul designatus" ;
    ont:derivedFromEntry <https://provincia.uni-graz.at/resource/entry/pir-a-544> ;
    ont:evidenceType "explicit" ;
    ont:exactText "Legatus Augusti pr. pr. (Arabiae)" ;
    ont:normalizedOffice <https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae> ;
    ont:note "Attested in inscriptions from Gerasa.",
        "In der PIR 'consul (suffectus anno incerto saec. II medii)' — die Klammer markiert Erschlossenes (belegt nur 'consul'); diese Datierung gilt dem KONSULAT, nicht der Statthalterschaft. Arabia-Statthalterschaft (CIL III 118 = 14156^3, Gerasa) faellt kurz vor das Konsulat (dort consul designatus). Moegliche Identitaet mit C. Allius C. f. Fuscianus (Ostia a. 140, a. 152)." ;
    ont:province <https://provincia.uni-graz.at/resource/province/arabia> .

