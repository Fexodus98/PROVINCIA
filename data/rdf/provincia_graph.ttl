<https://provincia.uni-graz.at/resource/factoid/pir-a-1070-gov-1070-1> a ont:GovernorshipFactoid ;
    ont:aboutPerson <https://provincia.uni-graz.at/resource/person/pir-a-1070-person-1070> ;
    ont:certainty "medium" ;
    ont:dateNormalizedEnd 166 ;
    ont:dateNormalizedStart 165 ;
    ont:dateText "a. 165/166 (Thomasson); consul designatus a. 166" ;
    ont:derivedFromEntry <https://provincia.uni-graz.at/resource/entry/pir-a-1070> ;
    ont:evidenceType "explicit" ;
    ont:exactText "legatus Aug. pr. pr. (exercitus Africani), consul designatus a. 166" ;
    ont:normalizedOffice <https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae> ;
    ont:note "De facto — wenn nicht de iure (Numidia wurde erst in severischer Zeit eigene kaiserliche Provinz) — Statthalter von Numidia als Befehlshaber der legio III Augusta (exercitus Africani). Moeglicherweise identisch mit der in CIL VIII 4195 (Verecunda) genannten Person (PIR: \"Nescio an idem sit\"). Bengt E. Thomasson, \"Die Statthalter der roemischen Provinzen Nordafrikas von Augustus bis Diokletian\" (S. 181), fuehrt einen Venustus als Statthalter Numidiens fuer 165/166. Personenidentitaet nicht voellig gesichert -> certainty=medium." ;
    ont:province <https://provincia.uni-graz.at/resource/province/numidia> .

