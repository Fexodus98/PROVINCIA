<https://provincia.uni-graz.at/resource/factoid/pir-a-1130-gov-arruntius-hispania> a ont:GovernorshipFactoid ;
    ont:aboutPerson <https://provincia.uni-graz.at/resource/person/pir-a-1130-person-l-arruntius> ;
    ont:certainty "high" ;
    ont:dateNormalizedStart 21 ;
    ont:dateText "A. 21 - 37" ;
    ont:derivedFromEntry <https://provincia.uni-graz.at/resource/entry/pir-a-1130> ;
    ont:evidenceType "explicit" ;
    ont:exactText "Hispaniam (citeriorem) regendam accepit (legatus Augusti pro praetore), sed provinciam absens gubernare coactus est, a Tiberio ob metum Romae retentus" ;
    ont:normalizedOffice <https://provincia.uni-graz.at/resource/office/legatus-augusti-pro-praetore-provinciae> ;
    ont:note "Arruntius was appointed to govern Hispania Citerior but was forced to govern in absence because Tiberius detained him in Rome out of fear.",
        "Enddatum ungewiss: 'incertum, num Hispaniae legationem usque ad finem vitae retinuerit'.",
        "Tacitus (Ann. 6, 27) states in 33 AD that Arruntius had been detained for ten years, though L. Piso was in charge of Hispania Citerior in 25 AD. It is probable that Arruntius succeeded Piso after the latter's death in 25 AD." ;
    ont:province <https://provincia.uni-graz.at/resource/province/hispania-citerior> ;
    ont:provinceText "Hispaniam (citeriorem)" ;
    ont:sourcePage 238 .

